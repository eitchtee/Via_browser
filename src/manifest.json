{
  "manifest_version": 3,
  "name": "Via",
  "version": "0.1.0",
  "description": "Send links, text and files between your devices through your own Via server.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Via",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "downloads",
    "notifications",
    "offscreen",
    "storage"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "minimum_chrome_version": "116"
}
